# Virtual environment
.venv/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Fetched data (regenerated by fetch.py)
data/raw/*.csv
!data/raw/.gitkeep

# Indicator catalogue cache (regenerated via fetch.py --refresh-catalogue)
config/indicator_catalogue.json

# Analysis output (regenerated by analyze.py)
data/analysis/*.json
data/analysis/*.md
!data/analysis/.gitkeep

# Report output (regenerated by report.py)
output/*.html
output/*.docx
output/assets/*.png
!output/.gitkeep
!output/assets/.gitkeep

# OS / editor
.DS_Store
desktop.ini
.vscode/
.idea/
.claude/
